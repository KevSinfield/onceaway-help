{
  "name": "onceaway-help-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Onceaway Help site, built from the Markdown in Docs/Help.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch --serve",
    "serve": "node build.mjs --serve",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "markdown-it": "14.3.1"
  }
}
